{
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "http://panelnexus.duckdns.org:3000/dashboard",
      "permanent": false
    },
    {
      "source": "/dashboard/",
      "destination": "http://panelnexus.duckdns.org:3000/dashboard",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/bot_data",
      "destination": "/api/public_stats"
    },
    {
      "source": "/api/stats/most-played",
      "destination": "/api/public/most-played"
    },
    {
      "source": "/api/discord_stats",
      "destination": "https://discord.com/api/v10/invites/fZNDG5sfhf?with_counts=true"
    },
    {
      "source": "/members",
      "destination": "/api/bot-proxy?path=/members"
    },
    {
      "source": "/admin_login",
      "destination": "/api/bot-proxy?path=/admin_login"
    },
    {
      "source": "/admin_dashboard",
      "destination": "/api/bot-proxy?path=/admin_dashboard"
    },
    {
      "source": "/servers",
      "destination": "/api/bot-proxy?path=/servers"
    },
    {
      "source": "/admin",
      "destination": "/api/bot-proxy?path=/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/bot-proxy?path=/admin/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/api/bot-proxy?path=/static/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://cdn.discordapp.com https://media.discordapp.net https://ui-avatars.com https://i.scdn.co; connect-src 'self' https://discord.com https://ninjanexus.duckdns.org; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/api/public_stats",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://ninjanexus.duckdns.org"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
